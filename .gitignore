.DS_Store
~$*
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Runtime outputs and heavy local artifacts
checkpoint/
checkpoints/
log/
logs/
runs/
outputs/
wandb/

# Editor/system files
.idea/
.vscode/
# Local/raw data generated outside source control
data/Original CSVs/
data/Changes Done/
data/processed_*/
data/merged_ed*.csv
data/rxnorm_mapping.csv
data/top300_meds.json

# Vendored GraphXAI: keep source code, ignore bundled datasets/results
external/GraphXAI-main/data/
external/GraphXAI-main/formal/
external/GraphXAI-main/examples/
external/GraphXAI-main/graphxai/datasets/real_world/**/*.npz
# Large datasets inside prot_gnn_core
prot_gnn_core/datasets/**/*.csv
prot_gnn_core/datasets/**/*.pt
prot_gnn_core/datasets/**/*.pth
prot_gnn_core/datasets/**/*.json

# Processed dataset artifacts
prot_gnn_core/datasets/**/processed/

# Generated explanations/results
prot_gnn_core/results/explanations/

# Model weights
*.pth