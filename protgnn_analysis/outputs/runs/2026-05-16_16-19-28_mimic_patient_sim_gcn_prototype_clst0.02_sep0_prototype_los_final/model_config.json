{
  "dataset": "mimic_patient_sim",
  "model": "gcn",
  "input_dim": "from dataset",
  "output_dim": 2,
  "latent_dim": [
    256,
    256,
    128
  ],
  "mlp_hidden": [
    64
  ],
  "readout": "max",
  "dropout": 0.3,
  "adj_normalize": true,
  "emb_normalize": true,
  "enable_prototypes": true,
  "num_prototypes_per_class": 5,
  "learning_rate": 0.001,
  "batch_size": 256,
  "weight_decay": 0.0001,
  "max_epochs": 300,
  "early_stopping": 20,
  "warm_epochs": 10,
  "proj_epochs": 100,
  "clst_weight": 0.02,
  "sep_weight": 0.0,
  "decision_threshold": 0.5249999999999999,
  "data_split_ratio": [
    0.8,
    0.1,
    0.1
  ],
  "seed": 1
}